# Copy this file to .env and fill in the values
# Local development does not need any keys

# EOA private key for deploying to testnets/mainnet (0x-prefixed)
PRIVATE_KEY=

# RPC URL for Sepolia (Alchemy/Infura/Ankr/etc.)
# Example Alchemy: https://eth-sepolia.g.alchemy.com/v2/your-key
SEPOLIA_RPC_URL=

# Optional alternative name used in config if you prefer
ALCHEMY_API_URL=
RPC_URL=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=
